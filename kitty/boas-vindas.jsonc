// Tela de boas-vindas do kitty (fastfetch). Chamada pelo ~/.zshenv só dentro do kitty.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // logo do Debian (o Sharingan do Itachi continua em sharingan.png), desenhado pelo protocolo gráfico do kitty
    "type": "kitty-direct",
    "source": "~/.config/kitty/debian.png",
    "width": 22,
    "height": 11,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "red", "title": "red" },
    "key": { "width": 12 }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#1;31}Guilherme{#}" },
    { "type": "custom", "format": "{#31}──────────────────────────────{#}" },
    { "type": "datetime", "key": "Date", "format": "{1}-{4}-{23} {14}:{18}" },
    { "type": "os", "key": "OS" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "shell", "key": "Shell" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk", "folders": "/" },
    { "type": "battery", "key": "Battery" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
