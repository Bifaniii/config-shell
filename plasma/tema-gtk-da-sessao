#!/usr/bin/env bash
# GNOME e Plasma dividem as mesmas configurações GTK (org.gnome.desktop.interface).
# Chamado no login (autostart) para cada sessão usar o próprio tema.
case "${1:-}" in
    gnome)
        # volta o que está no repo (WhiteSur-Dark etc.) e reseta o que o Plasma mudou por fora dele
        gsettings reset org.gnome.desktop.interface font-name
        gsettings reset org.gnome.desktop.interface cursor-theme
        # chaves que o kde-gtk-config do Plasma grava e o GNOME não usava
        for k in cursor-size enable-animations scaling-factor text-scaling-factor toolbar-style; do
            gsettings reset org.gnome.desktop.interface "$k"
        done
        dconf load /org/gnome/desktop/interface/ < "$HOME/config-shell/gnome/interface.dconf"
        # botões das janelas (o Plasma troca para "icon:minimize,maximize,close")
        gsettings set org.gnome.desktop.wm.preferences button-layout \
            "$(sed -n "/^\[wm\/preferences\]/,/^\[/ s/^button-layout=//p" "$HOME/config-shell/gnome/desktop.dconf" | tr -d "'")"
        ;;
    plasma)
        gsettings set org.gnome.desktop.interface gtk-theme 'Breeze'
        gsettings set org.gnome.desktop.interface icon-theme 'WhiteSur-dark'
        gsettings set org.gnome.desktop.interface cursor-theme 'WhiteSur-cursors'
        gsettings set org.gnome.desktop.interface font-name 'Noto Sans,  10'
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
        ;;
    *) echo "uso: $0 gnome|plasma"; exit 1 ;;
esac
